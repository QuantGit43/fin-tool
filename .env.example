# Copy this file to ../fin-data/.env and fill in real values.
# Never put real values in this file: it is committed to a public repository.

# Personal monobank API token (https://api.monobank.ua/), read-only access to your statements
MONO_TOKEN=

# Where personal data lives (outside the repository)
FIN_DB=../fin-data/fin.db
FIN_CONFIG_DIR=../fin-data
